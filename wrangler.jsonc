// Cloudflare Workers hosting (free tier). Oxygen and Workers share the same runtime,
// so the Hydrogen build runs here as-is: dist/server is the worker, dist/client the static files.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shop",
  "main": "dist/server/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {"directory": "dist/client"},
  "no_bundle": true,
  "rules": [{"type": "ESModule", "globs": ["**/*.js"]}],
  "vars": {
    // no Shopify store connected yet: Hydrogen's public demo API keeps the cart context happy
    "PUBLIC_STORE_DOMAIN": "mock.shop"
  }
  // SESSION_SECRET is a secret: set it in the Cloudflare dashboard (Settings → Variables and secrets)
}
